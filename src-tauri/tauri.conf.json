{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ZeroVPN",
  "version": "0.1.0",
  "identifier": "com.samuelbanapour.zerovpn",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZeroVPN",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Self-hosted WireGuard VPN client.",
    "longDescription": "ZeroVPN is a cross-platform WireGuard VPN client for self-hosted servers. Import your WireGuard configs, connect instantly, and manage split tunneling with a modern dashboard.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
